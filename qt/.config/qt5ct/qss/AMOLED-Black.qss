/* ===================================================================
 * AMOLED Black - Qt Style Sheet
 * Sharp, compact, flat black OLED design with maximum legibility.
 * =================================================================== */

QWidget {
    background-color: #000000;
    color: #c0c0c0;
    selection-background-color: #333333;
    selection-color: #ffffff;
}

QWidget:disabled {
    color: #505050;
}

/* === Tooltips === */
QToolTip {
    background-color: #121212;
    color: #e0e0e0;
    border: 1px solid #333333;
    padding: 3px 6px;
}

/* === Group Boxes === */
QGroupBox {
    margin-top: 12px;
    border: 1px solid #222222;
    padding: 6px 4px 4px 4px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #d0d0d0;
    background-color: #000000;
}
QGroupBox:disabled {
    border-color: #161616;
}
QGroupBox::title:disabled {
    color: #505050;
}

/* === Checkboxes & Radio Buttons === */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: #c0c0c0;
    background-color: transparent;
}
QCheckBox:hover, QRadioButton:hover {
    color: #ffffff;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #505050;
}

/* Checkbox Indicators (Sharp Square) */
QCheckBox::indicator,
QGroupBox::indicator,
QAbstractItemView::indicator {
    width: 13px;
    height: 13px;
    border: 1px solid #555555;
    background-color: #121212;
}
QCheckBox::indicator:hover,
QGroupBox::indicator:hover,
QAbstractItemView::indicator:hover {
    border-color: #888888;
    background-color: #1a1a1a;
}
QCheckBox::indicator:pressed,
QGroupBox::indicator:pressed,
QAbstractItemView::indicator:pressed {
    border-color: #aaaaaa;
    background-color: #242424;
}
QCheckBox::indicator:checked,
QGroupBox::indicator:checked,
QAbstractItemView::indicator:checked {
    border-color: #666666;
    background-color: #1a1a1a;
    image: url(/home/tonbix/.config/qt6ct/qss/icons/check.svg);
}
QCheckBox::indicator:checked:hover,
QGroupBox::indicator:checked:hover,
QAbstractItemView::indicator:checked:hover {
    border-color: #999999;
    background-color: #242424;
}
QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate {
    border-color: #666666;
    background-color: #1a1a1a;
    image: url(/home/tonbix/.config/qt6ct/qss/icons/dash.svg);
}
QCheckBox::indicator:indeterminate:hover,
QGroupBox::indicator:indeterminate:hover,
QAbstractItemView::indicator:indeterminate:hover {
    border-color: #999999;
    background-color: #242424;
}
QCheckBox::indicator:disabled,
QGroupBox::indicator:disabled,
QAbstractItemView::indicator:disabled {
    border-color: #252525;
    background-color: #080808;
}
QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled {
    border-color: #252525;
    background-color: #080808;
    image: url(/home/tonbix/.config/qt6ct/qss/icons/check-disabled.svg);
}
QCheckBox::indicator:indeterminate:disabled,
QGroupBox::indicator:indeterminate:disabled,
QAbstractItemView::indicator:indeterminate:disabled {
    border-color: #252525;
    background-color: #080808;
    image: url(/home/tonbix/.config/qt6ct/qss/icons/dash-disabled.svg);
}

/* Radio Button Indicators (Vector Circle) */
QRadioButton::indicator {
    width: 13px;
    height: 13px;
    border-radius: 7px;
    border: 1px solid #555555;
    background-color: #121212;
}
QRadioButton::indicator:hover {
    border-color: #888888;
    background-color: #1a1a1a;
}
QRadioButton::indicator:pressed {
    border-color: #aaaaaa;
    background-color: #242424;
}
QRadioButton::indicator:checked {
    border-color: #666666;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #ffffff, stop:0.48 #ffffff, stop:0.55 #1a1a1a, stop:1 #1a1a1a);
}
QRadioButton::indicator:checked:hover {
    border-color: #999999;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #ffffff, stop:0.48 #ffffff, stop:0.55 #242424, stop:1 #242424);
}
QRadioButton::indicator:disabled {
    border-color: #252525;
    background-color: #080808;
}
QRadioButton::indicator:checked:disabled {
    border-color: #252525;
    background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #505050, stop:0.48 #505050, stop:0.55 #080808, stop:1 #080808);
}

/* === Inputs (Text fields, Spinboxes) === */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #121212;
    padding: 3px 6px;
    border: 1px solid #2d2d2d;
    color: #e0e0e0;
}
QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit {
    padding-right: 18px;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #404040;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #606060;
    background-color: #151515;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #0a0a0a;
    border-color: #1a1a1a;
    color: #505050;
}

/* SpinBox Buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #2d2d2d;
    border-bottom: 1px solid #2d2d2d;
    background-color: #161616;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #222222;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/up-arrow.svg);
    width: 8px;
    height: 8px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/up-arrow-disabled.svg);
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #2d2d2d;
    background-color: #161616;
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #222222;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/down-arrow.svg);
    width: 8px;
    height: 8px;
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/down-arrow-disabled.svg);
}

/* === ComboBox === */
QComboBox {
    background-color: #121212;
    padding: 3px 6px;
    border: 1px solid #2d2d2d;
    color: #c0c0c0;
}
QComboBox:hover {
    border-color: #404040;
}
QComboBox:focus {
    border-color: #606060;
}
QComboBox:disabled {
    background-color: #0a0a0a;
    border-color: #1a1a1a;
    color: #505050;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border: none;
}
QComboBox::down-arrow {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/down-arrow.svg);
    width: 8px;
    height: 8px;
}
QComboBox::down-arrow:disabled {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/down-arrow-disabled.svg);
}
QComboBox QAbstractItemView {
    background-color: #0c0c0c;
    border: 1px solid #2d2d2d;
    selection-background-color: #2a2a2a;
    selection-color: #ffffff;
    color: #c0c0c0;
    padding: 2px;
    outline: none;
}

/* === Buttons (Push Buttons) === */
QPushButton {
    background-color: #161616;
    color: #c0c0c0;
    padding: 3px 10px;
    border: 1px solid #2a2a2a;
}
QPushButton:hover {
    background-color: #222222;
    border-color: #404040;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #101010;
    border-color: #505050;
}
QPushButton:checked {
    background-color: #282828;
    border-color: #505050;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #0a0a0a;
    color: #505050;
    border-color: #181818;
}

/* === Tool Buttons (Toolbars, Action Bars) === */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 2px 4px;
    margin: 1px;
    color: #c0c0c0;
}
QToolButton:hover {
    background-color: #1c1c1c;
    border-color: #333333;
    color: #ffffff;
}
QToolButton:pressed {
    background-color: #121212;
    border-color: #444444;
}
QToolButton:checked {
    background-color: #242424;
    border-color: #404040;
    color: #ffffff;
}
QToolButton:disabled {
    color: #505050;
    background-color: transparent;
    border-color: transparent;
}

/* === Progress Bar === */
QProgressBar {
    background-color: #121212;
    border: 1px solid #282828;
    text-align: center;
    color: #e0e0e0;
    height: 14px;
    font-size: 11px;
}
QProgressBar::chunk {
    background-color: #383838;
}
QProgressBar:disabled {
    border-color: #181818;
    color: #505050;
}
QProgressBar::chunk:disabled {
    background-color: #1e1e1e;
}

/* === Sliders === */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #252525;
}
QSlider::sub-page:horizontal {
    background: #505050;
}
QSlider::sub-page:horizontal:disabled {
    background: #2a2a2a;
}
QSlider::handle:horizontal {
    background: #888888;
    border: 1px solid #333333;
    width: 10px;
    height: 14px;
    margin: -5px 0;
}
QSlider::handle:horizontal:hover {
    background: #cccccc;
    border-color: #555555;
}
QSlider::handle:horizontal:disabled {
    background: #333333;
    border-color: #202020;
}

QSlider::groove:vertical {
    border: none;
    width: 4px;
    background: #252525;
}
QSlider::sub-page:vertical {
    background: #505050;
}
QSlider::sub-page:vertical:disabled {
    background: #2a2a2a;
}
QSlider::handle:vertical {
    background: #888888;
    border: 1px solid #333333;
    width: 14px;
    height: 10px;
    margin: 0 -5px;
}
QSlider::handle:vertical:hover {
    background: #cccccc;
    border-color: #555555;
}
QSlider::handle:vertical:disabled {
    background: #333333;
    border-color: #202020;
}

/* === Scrollbars === */
QScrollBar:vertical {
    border: none;
    background-color: #0a0a0a;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background-color: #2e2e2e;
    min-height: 25px;
}
QScrollBar::handle:vertical:hover {
    background-color: #444444;
}
QScrollBar::handle:vertical:pressed {
    background-color: #555555;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background-color: #0a0a0a;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background-color: #2e2e2e;
    min-width: 25px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #444444;
}
QScrollBar::handle:horizontal:pressed {
    background-color: #555555;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* === Tabs === */
QTabWidget::pane {
    border: 1px solid #222222;
    background-color: #000000;
    top: -1px;
}
QTabBar {
    qproperty-expanding: true;
    background-color: #000000;
    border: none;
}
QTabBar::tab {
    background: #0d0d0d;
    color: #888888;
    border: 1px solid #202020;
    border-bottom: none;
    padding: 4px 10px;
    margin-right: 1px;
}
QTabBar::tab:hover {
    color: #d0d0d0;
    background-color: #141414;
}
QTabBar::tab:selected {
    color: #ffffff;
    background-color: #1a1a1a;
    border-color: #333333;
    border-bottom: 2px solid #ffffff;
}

/* === Lists, Tables, Trees === */
QTreeView, QListView, QTableView {
    background-color: #000000;
    alternate-background-color: #0a0a0a;
    border: 1px solid #202020;
    gridline-color: #181818;
    color: #c0c0c0;
}
QTreeView::item, QListView::item, QTableView::item {
    padding: 2px;
}
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover {
    background-color: #161616;
}
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #282828;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #101010;
    color: #a0a0a0;
    padding: 3px 6px;
    border: 1px solid #202020;
    border-top: none;
    border-left: none;
    font-weight: bold;
}
QHeaderView::section:hover {
    background-color: #181818;
    color: #ffffff;
}
QHeaderView::up-arrow {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/up-arrow.svg);
    width: 8px;
    height: 8px;
}
QHeaderView::down-arrow {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/down-arrow.svg);
    width: 8px;
    height: 8px;
}
QTableCornerButton::section {
    background-color: #101010;
    border: 1px solid #202020;
}

/* === Menu Bar & Menus === */
QMenuBar {
    background-color: #000000;
    color: #c0c0c0;
    border-bottom: 1px solid #1a1a1a;
}
QMenuBar::item {
    background: transparent;
    padding: 3px 8px;
}
QMenuBar::item:selected {
    color: #ffffff;
    background-color: #1a1a1a;
}
QMenu {
    background-color: #0c0c0c;
    border: 1px solid #2a2a2a;
    padding: 2px;
}
QMenu::item {
    padding: 4px 20px 4px 16px;
    color: #c0c0c0;
}
QMenu::item:selected {
    color: #ffffff;
    background-color: #222222;
}
QMenu::item:disabled {
    color: #505050;
}
QMenu::separator {
    height: 1px;
    background-color: #202020;
    margin: 3px 4px;
}
QMenu::indicator {
    width: 12px;
    height: 12px;
    margin-left: 3px;
}
QMenu::indicator:non-exclusive:checked {
    image: url(/home/tonbix/.config/qt6ct/qss/icons/check.svg);
}
QMenu::indicator:non-exclusive:unchecked {
    border: 1px solid #444444;
    background-color: #101010;
}

/* === Status Bar === */
QStatusBar {
    background-color: #080808;
    color: #888888;
    border-top: 1px solid #1a1a1a;
}
QStatusBar::item {
    border: none;
}

/* === Splitter === */
QSplitter::handle {
    background-color: #181818;
}
QSplitter::handle:hover {
    background-color: #333333;
}
